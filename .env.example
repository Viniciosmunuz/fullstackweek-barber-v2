# Postgres (Neon) - pooled connection, used by the app at runtime
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Postgres (Neon) - direct connection, used by prisma migrate
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Painel de gestão
# Com "true", qualquer conta autenticada pode se conceder a gestão das
# barbearias de demonstração — útil para o ambiente de portfólio.
# Em produção, deixe em branco: o vínculo passa a existir apenas quando criado
# deliberadamente na tabela BarbershopManager.
DEMO_SELF_SERVICE=""
