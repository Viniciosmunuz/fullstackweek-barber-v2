generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  /// Exigido pelo provedor para emitir cobrança — não há como gerar PIX sem
  /// documento. Só é pedido a quem escolhe pagar o sinal na hora do
  /// agendamento; quem paga na barbearia nunca informa.
  cpfCnpj       String?
  /// Cliente fictício do catálogo de demonstração. O painel de gestão só
  /// exibe registros marcados assim (mais os do próprio usuário logado), para
  /// que dados de quem entra com a conta Google não fiquem visíveis a terceiros.
  isDemo        Boolean   @default(false)
  accounts      Account[]
  sessions      Session[]
  bookings      Booking[]
  manages       BarbershopManager[]
  notifications Notification[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum ManagerRole {
  OWNER
  STAFF
}

/// Vínculo entre uma pessoa e a barbearia que ela administra.
///
/// É o que autoriza ver e alterar dados no painel: sem uma linha aqui, o
/// usuário não enxerga nem edita nada daquele estabelecimento. Tabela de
/// junção (e não `Barbershop.ownerId`) porque uma barbearia costuma ter mais
/// de um responsável e um grupo pode administrar várias unidades.
/// E-mail liberado pela plataforma para administrar uma barbearia.
///
/// O convite existe porque o dono normalmente ainda não tem conta quando é
/// cadastrado: guarda-se o e-mail, e no primeiro login com o Google o vínculo
/// real (BarbershopManager) é criado automaticamente.
model BarbershopInvite {
  id           String      @id @default(uuid())
  /// Sempre gravado em minúsculas, para o confronto com o e-mail do Google
  /// não falhar por diferença de caixa.
  email        String
  barbershopId String
  barbershop   Barbershop  @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  role         ManagerRole @default(OWNER)
  acceptedAt   DateTime?
  createdAt    DateTime    @default(now())

  @@unique([email, barbershopId])
  @@index([email])
}

model BarbershopManager {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  barbershopId String
  barbershop   Barbershop  @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  role         ManagerRole @default(OWNER)
  createdAt    DateTime    @default(now())

  @@unique([userId, barbershopId])
  @@index([userId])
}

/// Aviso interno para quem administra uma barbearia.
///
/// Endereçada ao usuário, e não ao registro Barber: profissional é uma ficha da
/// barbearia e pode não ter conta. Quem precisa ser avisado de um agendamento
/// novo é quem opera a agenda.
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

/// Estados que a barbearia decide sobre o atendimento.
///
/// A espera pelo sinal NÃO entra aqui: ela é expressa por `Booking.expiresAt`.
/// Chegou a existir um `PENDING_PAYMENT`, e ele continua no banco porque
/// PostgreSQL não remove valor de enum — mas nada o usa. Declarar aqui um
/// quinto estado quebrava as uniões que o painel escreve à mão, e sobretudo
/// se confundia com `PENDING`, que é um estado que a barbearia escolhe no
/// painel e significa outra coisa.
enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

/// Como um valor é calculado: percentual sobre o preço do serviço ou fixo.
enum FeeType {
  PERCENT
  FIXED
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  REFUNDED
  FAILED
}

enum PaymentMethod {
  PIX
  CARD
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Barbershop {
  id          String              @id @default(uuid())
  name        String
  slug        String              @unique
  slogan      String
  address     String
  /// Bairro exibido nos cards. O endereço completo é longo demais para um card
  /// de grade, e o bairro é o que o cliente usa para decidir se fica perto.
  neighborhood String?
  city        String
  phones      String[]
  description String
  imageUrl    String
  /// Só barbearias publicadas aparecem no catálogo público. Uma casa recém
  /// cadastrada pela plataforma nasce despublicada, para o dono completar o
  /// cadastro antes de receber cliente.
  isPublished Boolean             @default(false)
  /// Identifica qual componente de logo SVG renderizar (ver _components/brand/barbershop-logo.tsx)
  logoKey     String
  /// Logo real da barbearia, hospedada publicamente. Quando nula, o card cai
  /// na silhueta de `logoKey` — barbearia recém-cadastrada precisa de alguma
  /// marca antes de ter a dela pronta.
  logoUrl     String?
  /// Cor de destaque da marca em hex, usada nos acentos do card e da página
  accentColor String
  rating      Decimal             @default(5.0) @db.Decimal(2, 1)
  reviewCount Int                 @default(0)

  /// ---------------------------------------------------------------------
  /// Cobrança do sinal
  /// ---------------------------------------------------------------------
  /// Só cobra sinal quem tem carteira configurada. Enquanto for `false`, o
  /// agendamento segue o fluxo antigo — é o que permite ligar a cobrança
  /// barbearia por barbearia sem interromper quem já opera.
  paymentsEnabled  Boolean  @default(false)
  /// Carteira da barbearia no provedor, destino do repasse do split.
  payoutWalletId   String?
  /// Sinal pago pelo cliente na reserva, abatido do serviço na loja.
  /// Quem define é a barbearia: é a política de no-show dela.
  depositType      FeeType  @default(PERCENT)
  depositValue     Decimal  @default(30) @db.Decimal(10, 2)
  /// Taxa da plataforma por agendamento. Definida pela administração da
  /// plataforma, nunca pela barbearia — é receita de quem opera o produto, e
  /// deixar o lojista editar seria deixá-lo zerar a própria conta.
  ///
  /// Zero por decisão de produto: enquanto o BarberFlow estiver conquistando as
  /// primeiras parceiras, o sinal inteiro vai para a barbearia. O campo existe e
  /// o cálculo já sabe lidar com ele — ligar a taxa é mudar um número, não
  /// escrever código.
  platformFeeType  FeeType  @default(PERCENT)
  platformFeeValue Decimal  @default(0) @db.Decimal(10, 2)

  openingHours OpeningHour[]
  images      ImageAsset[]
  barbers     Barber[]
  managers    BarbershopManager[]
  invites     BarbershopInvite[]
  services    BarbershopService[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

/// Imagem enviada do dispositivo, guardada no próprio banco.
///
/// Não há bucket de objetos nesta instalação, e acrescentar um exigiria uma
/// dependência nova e mais uma conta para configurar antes de qualquer foto
/// subir. Os arquivos aqui são pequenos — o navegador reduz a imagem antes de
/// enviar — e a rota que os serve manda cache imutável, então cada um é baixado
/// uma vez e nunca mais.
///
/// A linha é presa à barbearia para o dia em que ela sair: sem isso, os bytes
/// ficariam no banco sem ninguém que os reclame.
model ImageAsset {
  id           String     @id @default(uuid())
  /// `image/webp` na maioria dos casos — é o que o navegador produz ao reduzir.
  mimeType     String
  data         Bytes
  byteSize     Int
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([barbershopId])
}

model OpeningHour {
  id           String     @id @default(uuid())
  /// 0 = domingo ... 6 = sábado
  weekday      Int
  opensAt      String?
  closesAt     String?
  closed       Boolean    @default(false)
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([barbershopId, weekday])
}

model Barber {
  id           String     @id @default(uuid())
  name         String
  specialty    String
  bio          String
  imageUrl     String
  /// Profissional inativo some da escolha no agendamento, mas mantém o
  /// histórico já registrado.
  active       Boolean    @default(true)
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  schedule     BarberSchedule[]
  timeOff      BarberTimeOff[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

/// Grade semanal própria de um profissional.
///
/// Sem nenhuma linha aqui, ele segue o horário da casa — que é o caso da
/// maioria e evita obrigar o dono a preencher a mesma coisa para cada barbeiro.
/// Havendo linhas, elas substituem a grade da casa por inteiro: meia mistura
/// ("abre com a casa, fecha com ele") seria impossível de explicar na tela.
model BarberSchedule {
  id       String  @id @default(uuid())
  /// 0 = domingo ... 6 = sábado
  weekday  Int
  closed   Boolean @default(false)
  opensAt  String?
  closesAt String?
  barberId String
  barber   Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, weekday])
}

/// Ausência de um profissional: folga, férias, compromisso.
///
/// Guardada como intervalo, e não como dia, porque metade das ausências reais
/// são de algumas horas — dentista de manhã, sai mais cedo na sexta. Um dia
/// inteiro é só um intervalo que começa e termina na virada.
model BarberTimeOff {
  id       String   @id @default(uuid())
  startsAt DateTime
  endsAt   DateTime
  /// Aparece só para a barbearia, nunca para o cliente.
  reason   String?
  barberId String
  barber   Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, startsAt])
}

model BarbershopService {
  id              String     @id @default(uuid())
  name            String
  description     String
  imageUrl        String
  price           Decimal    @db.Decimal(10, 2)
  /// Duração estimada do serviço em minutos
  durationMinutes Int        @default(30)
  barbershopId    String
  barbershop      Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  bookings        Booking[]
}

model Booking {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  serviceId String
  service   BarbershopService @relation(fields: [serviceId], references: [id])
  barberId  String?
  barber    Barber?           @relation(fields: [barberId], references: [id])
  date      DateTime
  status    BookingStatus     @default(CONFIRMED)
  /// Prazo para o sinal chegar. Enquanto não vence, o horário fica preso a
  /// esta reserva; vencido, volta para a lista sem precisar apagar o registro
  /// — o histórico de tentativa de pagamento continua auditável.
  expiresAt DateTime?
  payment   Payment?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([date])
  @@index([barberId, date])
  @@index([status, expiresAt])
}

/// Sinal de um agendamento.
///
/// Os três valores são gravados no momento da cobrança e não são recalculados
/// depois: se a taxa da plataforma mudar amanhã, o que já foi cobrado precisa
/// continuar contando a história de ontem.
model Payment {
  id          String        @id @default(uuid())
  bookingId   String        @unique
  /// `Restrict`, e não `Cascade`: apagar uma reserva não pode levar junto o
  /// registro do pagamento. Numa reserva já paga isso apagaria o rastro
  /// financeiro — dinheiro que entrou sumindo do relatório. Destruir registro
  /// de cobrança passou a exigir apagá-lo explicitamente antes.
  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  status      PaymentStatus @default(PENDING)
  method      PaymentMethod @default(PIX)
  /// Total cobrado do cliente
  amount      Decimal       @db.Decimal(10, 2)
  /// Parte retida pela plataforma
  platformFee Decimal       @db.Decimal(10, 2)
  /// Parte repassada à barbearia pelo split
  shopAmount  Decimal       @db.Decimal(10, 2)
  /// Id da cobrança no provedor. Único para o webhook não conseguir vincular
  /// o mesmo pagamento a duas reservas.
  providerId  String?       @unique
  checkoutUrl String?
  pixPayload  String?
  expiresAt   DateTime
  paidAt      DateTime?
  refundedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  events PaymentEvent[]

  @@index([status, expiresAt])
}

/// Webhook recebido do provedor, guardado antes de ser aplicado.
///
/// `providerEventId` é único: o provedor reenvia o mesmo evento quando não
/// recebe 200, e sem essa trava um reenvio confirmaria a reserva duas vezes ou
/// somaria a taxa em dobro no relatório.
model PaymentEvent {
  id              String   @id @default(uuid())
  providerEventId String   @unique
  paymentId       String?
  payment         Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  type            String
  payload         Json
  receivedAt      DateTime @default(now())

  @@index([paymentId])
}
