generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  /// Cliente fictício do catálogo de demonstração. O painel de gestão só
  /// exibe registros marcados assim (mais os do próprio usuário logado), para
  /// que dados de quem entra com a conta Google não fiquem visíveis a terceiros.
  isDemo        Boolean   @default(false)
  accounts      Account[]
  sessions      Session[]
  bookings      Booking[]
  manages       BarbershopManager[]
  notifications Notification[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum ManagerRole {
  OWNER
  STAFF
}

/// Vínculo entre uma pessoa e a barbearia que ela administra.
///
/// É o que autoriza ver e alterar dados no painel: sem uma linha aqui, o
/// usuário não enxerga nem edita nada daquele estabelecimento. Tabela de
/// junção (e não `Barbershop.ownerId`) porque uma barbearia costuma ter mais
/// de um responsável e um grupo pode administrar várias unidades.
/// E-mail liberado pela plataforma para administrar uma barbearia.
///
/// O convite existe porque o dono normalmente ainda não tem conta quando é
/// cadastrado: guarda-se o e-mail, e no primeiro login com o Google o vínculo
/// real (BarbershopManager) é criado automaticamente.
model BarbershopInvite {
  id           String      @id @default(uuid())
  /// Sempre gravado em minúsculas, para o confronto com o e-mail do Google
  /// não falhar por diferença de caixa.
  email        String
  barbershopId String
  barbershop   Barbershop  @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  role         ManagerRole @default(OWNER)
  acceptedAt   DateTime?
  createdAt    DateTime    @default(now())

  @@unique([email, barbershopId])
  @@index([email])
}

model BarbershopManager {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  barbershopId String
  barbershop   Barbershop  @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  role         ManagerRole @default(OWNER)
  createdAt    DateTime    @default(now())

  @@unique([userId, barbershopId])
  @@index([userId])
}

/// Aviso interno para quem administra uma barbearia.
///
/// Endereçada ao usuário, e não ao registro Barber: profissional é uma ficha da
/// barbearia e pode não ter conta. Quem precisa ser avisado de um agendamento
/// novo é quem opera a agenda.
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum FeeType {
  PERCENT
  FIXED
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Barbershop {
  id          String              @id @default(uuid())
  name        String
  slug        String              @unique
  slogan      String
  address     String
  /// Bairro exibido nos cards. O endereço completo é longo demais para um card
  /// de grade, e o bairro é o que o cliente usa para decidir se fica perto.
  neighborhood String?
  city        String
  phones      String[]
  description String
  imageUrl    String
  /// Só barbearias publicadas aparecem no catálogo público. Uma casa recém
  /// cadastrada pela plataforma nasce despublicada, para o dono completar o
  /// cadastro antes de receber cliente.
  isPublished Boolean             @default(false)
  /// Identifica qual componente de logo SVG renderizar (ver _components/brand/barbershop-logo.tsx)
  logoKey     String
  /// Cor de destaque da marca em hex, usada nos acentos do card e da página
  accentColor String
  rating      Decimal             @default(5.0) @db.Decimal(2, 1)
  reviewCount Int                 @default(0)
  openingHours OpeningHour[]
  barbers     Barber[]
  managers    BarbershopManager[]
  invites     BarbershopInvite[]
  services    BarbershopService[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model OpeningHour {
  id           String     @id @default(uuid())
  /// 0 = domingo ... 6 = sábado
  weekday      Int
  opensAt      String?
  closesAt     String?
  closed       Boolean    @default(false)
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([barbershopId, weekday])
}

model Barber {
  id           String     @id @default(uuid())
  name         String
  specialty    String
  bio          String
  imageUrl     String
  /// Profissional inativo some da escolha no agendamento, mas mantém o
  /// histórico já registrado.
  active       Boolean    @default(true)
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model BarbershopService {
  id              String     @id @default(uuid())
  name            String
  description     String
  imageUrl        String
  price           Decimal    @db.Decimal(10, 2)
  /// Duração estimada do serviço em minutos
  durationMinutes Int        @default(30)
  barbershopId    String
  barbershop      Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  bookings        Booking[]
}

model Booking {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  serviceId String
  service   BarbershopService @relation(fields: [serviceId], references: [id])
  barberId  String?
  barber    Barber?           @relation(fields: [barberId], references: [id])
  date      DateTime
  status    BookingStatus     @default(CONFIRMED)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([date])
  @@index([barberId, date])
}
