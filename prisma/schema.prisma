generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  /// Cliente fictício do catálogo de demonstração. O painel de gestão só
  /// exibe registros marcados assim (mais os do próprio usuário logado), para
  /// que dados de quem entra com a conta Google não fiquem visíveis a terceiros.
  isDemo        Boolean   @default(false)
  accounts      Account[]
  sessions      Session[]
  bookings      Booking[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Barbershop {
  id          String              @id @default(uuid())
  name        String
  slug        String              @unique
  slogan      String
  address     String
  city        String
  phones      String[]
  description String
  imageUrl    String
  /// Identifica qual componente de logo SVG renderizar (ver _components/brand/barbershop-logo.tsx)
  logoKey     String
  /// Cor de destaque da marca em hex, usada nos acentos do card e da página
  accentColor String
  rating      Decimal             @default(5.0) @db.Decimal(2, 1)
  reviewCount Int                 @default(0)
  openingHours OpeningHour[]
  barbers     Barber[]
  services    BarbershopService[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model OpeningHour {
  id           String     @id @default(uuid())
  /// 0 = domingo ... 6 = sábado
  weekday      Int
  opensAt      String?
  closesAt     String?
  closed       Boolean    @default(false)
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([barbershopId, weekday])
}

model Barber {
  id           String     @id @default(uuid())
  name         String
  specialty    String
  bio          String
  imageUrl     String
  /// Profissional inativo some da escolha no agendamento, mas mantém o
  /// histórico já registrado.
  active       Boolean    @default(true)
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model BarbershopService {
  id              String     @id @default(uuid())
  name            String
  description     String
  imageUrl        String
  price           Decimal    @db.Decimal(10, 2)
  /// Duração estimada do serviço em minutos
  durationMinutes Int        @default(30)
  barbershopId    String
  barbershop      Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  bookings        Booking[]
}

model Booking {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  serviceId String
  service   BarbershopService @relation(fields: [serviceId], references: [id])
  barberId  String?
  barber    Barber?           @relation(fields: [barberId], references: [id])
  date      DateTime
  status    BookingStatus     @default(CONFIRMED)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([date])
  @@index([barberId, date])
}
